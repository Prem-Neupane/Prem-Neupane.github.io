    "babel-register": "^6.26.0",
    "bootstrap": "^4.6.0",
    "gh-pages": "^3.2.3",
    "react": "^17.0.1",
    "react-bootstrap": "^1.4.3",
    "react-dom": "^17.0.1",
    "react-router-dom": "^5.2.0",
    "react-router-sitemap": "^1.2.0",
